# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Python & scripts
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf

# Config & documentation
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.aab binary
*.apk binary
